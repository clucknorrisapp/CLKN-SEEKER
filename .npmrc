# @solana-mobile/wallet-adapter-mobile pulls @react-native-async-storage/async-storage as an
# OPTIONAL dependency, which in turn peers on react-native, which peerOptional-demands
# @types/react@^19 while this app is on React 18. We are a Capacitor WebView app and never
# import react-native — the conflict is entirely in a types package for code we do not ship.
#
# Without this, `npm install` succeeds and `npm ci` fails with ERESOLVE, so a working dev
# machine and a red CI disagree about the same lockfile. This makes them agree.
legacy-peer-deps=true
